{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "unit.schema.json",
  "title": "Unit (Lerneinheit)",
  "description": "Metadaten einer Lerneinheit (meta.json)",
  "type": "object",
  "required": ["schemaVersion", "id", "slug", "title", "description", "stations", "citations"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "description": "Eindeutige ID der Einheit"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL-Slug"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Titel der Einheit"
    },
    "description": {
      "type": "string",
      "description": "Kurzbeschreibung der Einheit"
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Dateinamen der Stationen in Reihenfolge"
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "citation.schema.json"
      },
      "description": "Belege zur Einheit"
    }
  },
  "additionalProperties": true
}
