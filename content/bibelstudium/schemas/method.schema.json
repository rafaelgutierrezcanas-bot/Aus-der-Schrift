{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "method.schema.json",
  "title": "Method (Methoden-Eintrag)",
  "description": "Eintrag in der Methodenbibliothek",
  "type": "object",
  "required": ["schemaVersion", "id", "slug", "title", "description", "steps", "citations"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "citation.schema.json"
      }
    }
  },
  "additionalProperties": true
}
